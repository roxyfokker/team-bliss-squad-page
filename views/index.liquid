{% render 'partials/head.liquid', persons: persons %}

<!-- sorteren en filteren werkend -->
<a href="/?sort=name">Sorteer A-Z</a>
<a href="/?sort=-name">Sorteer Z_A</a>
<a href="/?sort=birthdate">Sorteer op geboortedatum</a>
<a href="/?sort=-birthdate">Sorteer op geboortedatum</a>

<a href="/?filter[squads][squad_id][_eq]=16">filteren 1I</a>
<a href="/?filter[squads][squad_id][_eq]=17">filteren 1J</a>

<main>
  <!--
    zoeken, filteren en sorteren -> mohamed --------------------------------------------------------------------------------------
  -->

  <section class="controls">
    <!-- sorteren -->
    <!-- Zoeken op naam -->
    <h1>Zoek je squad-mate!</h1>

    <form method="GET" action="/">
      <label>
        Zoek op naam
        <input type="text" name="name" placeholder="Zoek op naam">
      </label>
    </form>

    <select
      id="sort-select"
    >
      <!-- https://stackoverflow.com/questions/7562095/redirect-on-select-option-in-select-box -->
      <option
        value="/?sort=name"
        {% if currentSort == 'name' %}
          selected
        {% endif %}
      >
        Naam A-Z
      </option>
      <option
        value="/?sort=-name"
        {% if currentSort == '-name' %}
          selected
        {% endif %}
      >
        Naam Z-A
      </option>
      <option
        value="/?sort=birthdate"
        {% if currentSort == 'birthdate' %}
          selected
        {% endif %}
      >
        Oudste
      </option>
      <option
        value="/?sort=-birthdate"
        {% if currentSort == '-birthdate' %}
          selected
        {% endif %}
      >
        Jongste
      </option>
      <option value="">Meeste likes</option>
      <option value="">Minste likes</option>
    </select>

    <!-- filteren -->
    <select
      id="filter-select"
      onchange="this.options[this.selectedIndex].value && (window.location = this.options[this.selectedIndex].value);"
    >
      <!-- https://stackoverflow.com/questions/7562095/redirect-on-select-option-in-select-box -->
      <option
        value="/?filter[squads][squad_id][_eq]=16"
        {% if currentSquad == '16' %}
          selected
        {% endif %}
      >
        Squad 1I
      </option>
      <option
        value="/?filter[squads][squad_id][_eq]=17"
        {% if currentSquad == '17' %}
          selected
        {% endif %}
      >
        Squad 1J
      </option>
      <option value="">Student</option>
      <option value="">Docent</option>
    </select>
  </section>

  <!--
    personen kaartjes -> Thomas ---------------------------------------------------------------------------------------------------
  -->
  <section>
    <ul class="squad-list">
      {% for person in persons %}
        <li>
          <article class="member" style="border-top: 3px solid {{ person.fav_color }};">
            <!-- Header -->
            <ul class="member-header">
              <li class="header-avatar">
                <img src="{{ person.avatar }}" alt="{{ person.name }}" class="profile-pic">
              </li>
              <li class="header-info">
                <h3>{{ person.name }}</h3>
                {% if filterBy == 'birthdate' and person.daysUntilBirthday %}
                  <p class="birthday-countdown">{{ person.daysUntilBirthday }} dagen tot verjaardag</p>
                {% endif %}
              </li>
            </ul>

            <!-- Content -->
            <ul class="member-content">
              <li>
                <img src="{{ person.avatar }}" alt="{{ person.name }}" class="content-image">
              </li>
            </ul>

            <!-- Actions -->
            <ul class="member-actions">
              <li><button class="action-btn like-btn">👍</button></li>
              <li><button class="action-btn comment-btn">💬</button></li>
              <li><a href="/student/{{ person.id }}" class="action-btn meer-btn">See more...</a></li>
            </ul>
          </article>
        </li>
      {% endfor %}
    </ul>
  </section>
</main>

{% render 'partials/foot.liquid', squads: squads %}
