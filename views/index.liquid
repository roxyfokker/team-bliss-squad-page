{% render 'partials/head.liquid', persons: persons %}

<main>
  <!--
    zoeken, filteren en sorteren -> mohamed --------------------------------------------------------------------------------------
  -->

  <section class="controls">
    <!-- sorteren -->
    <!-- Zoeken op naam -->
    <h1>Zoek je squad-mate!</h1>

    <form method="GET" action="/">
      <label>
        <span class="label-text">Zoek op naam</span>
        <input type="text" name="search" placeholder="Zoek op naam">
      </label>

      <select
        id="sort-select"
        name="sort"
      >
        <option value="">Sorteer</option>
        <option
          value="name"
          {% if currentSort == 'name' %}
            selected
          {% endif %}
        >
          Naam A-Z
        </option>
        <option
          value="-name"
          {% if currentSort == '-name' %}
            selected
          {% endif %}
        >
          Naam Z-A
        </option>
        <option
          value="birthdate"
          {% if currentSort == 'birthdate' %}
            selected
          {% endif %}
        >
          Oudste
        </option>
        <option
          value="-birthdate"
          {% if currentSort == '-birthdate' %}
            selected
          {% endif %}
        >
          Jongste
        </option>
        <option value="">Meeste likes</option>
        <option value="">Minste likes</option>
      </select>

      <!-- filteren -->
      <select
        id="filter-select"
        name="squad"
      >
        <!-- https://stackoverflow.com/questions/7562095/redirect-on-select-option-in-select-box -->
        <option value="">Filter</option>
        <option
          value="16"
          {% if currentSquad == '16' %}
            selected
          {% endif %}
        >
          Squad 1I
        </option>
        <option
          value="17"
          {% if currentSquad == '17' %}
            selected
          {% endif %}
        >
          Squad 1J
        </option>
        <option value="">Student</option>
        <option value="">Docent</option>
      </select>
      <button type="submit">Toon resultaten</button>
    </form>
  </section>

  <!--
    personen kaartjes -> Thomas ---------------------------------------------------------------------------------------------------
  -->
  <section>
    <ul class="squad-list">
      {% for person in persons %}
        <li>
          <article class="member" style="border-top: 3px solid {{ person.fav_color }};">
            <!-- Header -->
            <ul class="member-header">
              <li class="header-avatar">
                <img src="{{ person.avatar }}" alt="{{ person.name }}" class="profile-pic">
              </li>
              <li class="header-info">
                <h3>{{ person.name }}</h3>
                {% if currentSort == 'birthdate' or currentSort == '-birthdate' %}
                  <p class="birthday">{{ person.birthdate }}</p>
                {% elsif currentSort == 'birthday' and person.daysUntilBirthday %}
                  <p class="birthday">{{ person.birthday }} dagen tot verjaardag</p>
                {% endif %}
              </li>
            </ul>

            <!-- Slideshowtje -->
            <ul class="member-content" data-slideshow>
              <li class="slideshow-slide active">
                <img src="{{ person.avatar }}" alt="{{ person.name }}" class="content-image">
              </li>
              <li class="slideshow-slide">
                <iframe
                  title="Locatie {{ person.residency }}"
                  class="embed-map-frame"
                  frameborder="0"
                  scrolling="no"
                  marginheight="0"
                  marginwidth="0"
                  src="https://maps.google.com/maps?width=600&height=400&hl=en&q={{ person.residency | url_escape }}&t=&z=14&ie=UTF8&iwloc=B&output=embed"
                >
                </iframe>
              </li>
              <li class="slideshow-slide">
                <iframe
                  title="Spotify track embed"
                  class="spotify-embed"
                  style="border-radius:12px; border: none; width: 100%; height: 100%; aspect-ratio: auto;"
                  src="https://open.spotify.com/embed/track/{{ track_id | default: '7qBNJBQJJjQjYFZlP3IPhK?si=635574fedc974a50' }}?utm_source=generator"
                  frameBorder="0"
                  allowfullscreen=""
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  loading="lazy"
                >
                </iframe>
              </li>
              <button class="slideshow-btn prev" onclick="changeSlide(event, -1)">❮</button>
              <button class="slideshow-btn next" onclick="changeSlide(event, 1)">❯</button>
            </ul>

            <!-- Actions -->
            <ul class="member-actions">
              <li><button class="action-btn like-btn">👍</button></li>
              <li><button class="action-btn comment-btn">💬</button></li>
              <li><a href="/student/{{ person.id }}" class="action-btn meer-btn">See more...</a></li>
            </ul>
          </article>
        </li>
      {% endfor %}
    </ul>
  </section>
</main>

{% render 'partials/foot.liquid', squads: squads %}
