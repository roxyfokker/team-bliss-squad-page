{% render 'partials/head.liquid' %}

<!--
  Alle personen -> roxy --------------------------------------------------------------------------------------------------------
-->
<header>
  <ul>
    {% for person in persons %}
      <li>
        <a href="/student/{{ person.id }}">
          <figure>
            {% if person.mugshot %}
              <img src="https://fdnd.directus.app/assets/{{ person.mugshot }}?width=500" alt="Profile picture">
            {% else %}
              <img src="/images/missing-mugshot.png" alt="No profile picture">
            {% endif %}
            <figcaption>
              {{ person.name }}
            </figcaption>
          </figure>
        </a>
      </li>
    {% endfor %}
  </ul>
</header>


<!--
  sorteren en filteren werkend
-->
<a href="/?sort=name">Sorteer A-Z</a>
<a href="/?sort=-name">Sorteer Z_A</a>
<a href="/?sort=birthdate">Sorteer op geboortedatum</a>
<a href="/?sort=-birthdate">Sorteer op geboortedatum</a>

<a href="/?filter[squads][squad_id][_eq]=16">filteren 1I</a>
<a href="/?filter[squads][squad_id][_eq]=17">filteren 1J</a>


<!--
  zoeken, filteren en sorteren -> mohamed --------------------------------------------------------------------------------------
-->

<section>
  <!-- Zoeken op naam -->
  <h1>Zoek je squad-mate!</h1>

  <form method="GET" action="/">
      <label>
        Zoek op naam
        <input type="text" name="name" placeholder="Zoek op naam">
      </label>
  </form>  

  <div class="controls">
    <div class="filters">
      <!-- sorteren -->
      
      <select id="sort-select" onchange="this.options[this.selectedIndex].value && (window.location = this.options[this.selectedIndex].value);" ><!--https://stackoverflow.com/questions/7562095/redirect-on-select-option-in-select-box-->
        <option value="/?sort=name">Naam A-Z</option>
        <option value="/?sort=-name">Naam Z-A</option>
        <option value="/?sort=birthdate">Birthdate</option>
        <option value="/?sort=-birthdate">Birthdate</option>
        <option value="">Aantal likes</option>
      </select>
      
      <!-- filteren -->
      <select id="filter-select" onchange="this.options[this.selectedIndex].value && (window.location = this.options[this.selectedIndex].value);"><!--https://stackoverflow.com/questions/7562095/redirect-on-select-option-in-select-box-->
        <option value="/?filter[squads][squad_id][_eq]=16">Squad 1I</option>
        <option value="/?filter[squads][squad_id][_eq]=17">Squad 1J</option>
        <option value="">Student</option>
        <option value="">Docent</option>
      </select>
    </div> 
  </div>
  
</section>

<main>
  <!--
    personen kaartjes -> Thomas ---------------------------------------------------------------------------------------------------
  -->
    <section>
      <ul class="squad-list">
        {% for person in persons %}
          <li>
            <article class="member" style="border-top: 3px solid {{ person.fav_color }};">
              <!-- Header -->
              <ul class="member-header">
                <li class="header-avatar">
                  <img src="{{ person.avatar }}" alt="{{ person.name }}" class="profile-pic">
                </li>
                <li class="header-info">
                  <h3>{{ person.name }}</h3>
                  {% if filterBy == 'birthdate' and person.daysUntilBirthday %}
                    <p class="birthday-countdown">{{ person.daysUntilBirthday }} dagen tot verjaardag</p>
                  {% endif %}
                </li>
              </ul>
              
              <!-- Content -->
              <ul class="member-content">
                <li>
                  <img src="{{ person.avatar }}" alt="{{ person.name }}" class="content-image">
                </li>
              </ul>
              
              <!-- Actions -->
              <ul class="member-actions">
                <li><button class="action-btn like-btn">👍</button></li>
                <li><button class="action-btn comment-btn">💬</button></li>
                <li><a href="/student/{{ person.id }}" class="action-btn meer-btn">See more...</a></li>
              </ul>
            </article>
          </li>
        {% endfor %}
      </ul>
    </section>
</main>
