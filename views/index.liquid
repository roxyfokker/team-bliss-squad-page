{% render 'partials/head.liquid' %}

<!-- Alle personen -> roxy ---------------------------------------------------------------------------------------------------------->
<header>
  <ul>
    {% for person in persons %}
    <li>
      <a href="/student/{{ person.id }}">
        <figure>
          {% if person.mugshot %}
          <img src="https://fdnd.directus.app/assets/{{ person.mugshot }}?width=500" alt="Profile picture">
          {% else %}
          <img src="/images/missing-mugshot.png" alt="No profile picture">
          {% endif %}
          <figcaption>
            {{  person.name }}
          </figcaption>
        </figure>
      </a>
    </li>
    {% endfor %}
  </ul>
</header>

<!-- zoeken, filteren en sorteren -> mohamed ---------------------------------------------------------------------------------------->
<section>
  <!--Zoeken op naam-->
  <form method="GET" action="/">
    <label>
      Zoek op naam
      <input type="text" name="name" placeholder="Typ een naam..."/>
    </label>

    <button type="submit">Zoeken</button>

    <a href="/" class="reset-link">Reset</a>
  </form>

  <!--filteren-->
  <!--sorteren-->

</section>

<main>
<!-- personen kaartjes -> Thomas ----------------------------------------------------------------------------------------------------->
  <ul>
    <li>
    </li>
  </ul>
</main>











