{% render 'partials/head.liquid' %}

<!--
  Alle personen -> roxy --------------------------------------------------------------------------------------------------------
-->
<header>
  <ul>
    {% for person in persons %}
      <li>
        <a href="/student/{{ person.id }}">
          <figure>
            {% if person.mugshot %}
              <img src="https://fdnd.directus.app/assets/{{ person.mugshot }}?width=500" alt="Profile picture">
            {% else %}
              <img src="/images/missing-mugshot.png" alt="No profile picture">
            {% endif %}
            <figcaption>
              {{ person.name }}
            </figcaption>
          </figure>
        </a>
      </li>
    {% endfor %}
  </ul>
</header>

<!--
  zoeken, filteren en sorteren -> mohamed --------------------------------------------------------------------------------------
-->
<section>
  <!-- Zoeken op naam -->
  <form method="GET" action="/">
    <form>
      <h1>Zoek je squad-mate!</h1>
      <div class="controls">
        <input type="search" placeholder="Zoek op naam">
        <div class="filters">
          <select id="sort-select">
            <option value="">Sorteren</option>
            <option value="likes">Aantal likes</option>
            <option value="az">Naam A-Z</option>
            <option value="za">Naam Z-A</option>
            <option value="birthdate">Birthdate</option>
          </select>

          <select id="filter-select">
            <option value="">Filter</option>
            <option value="1I">Squad 1I</option>
            <option value="1J">Squad 1J</option>
            <option value="role-student">Student</option>
            <option value="role-docent">Docent</option>
          </select>
        </div>
      </div>
    </form>
  </form>
  {% comment %} style. van zoekbalk tijdelijk in html {% endcomment %}

  <style>
    h1 {
      font-size: 30px;
      font-family: sans-serif;
      font-weight: normal;
    }
    input[type='search'],
    .controls select {
      width: 100%;
      border-radius: 12px;
      border: 1px solid grey;
      padding: 0 16px;
    }

    .controls {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 300px;
    }

    .filters {
      display: flex;
      gap: 10px;
      width: 100%;
    }
    .filters select {
      flex: 1;
    }

    .controls input {
      width: 100%;
    }
    select:hover,
    select:focus {
      background: #dddddd;
    }
  </style>
  <!-- filteren -->
  <!-- sorteren -->
</section>

<main>
  <!--
    personen kaartjes -> Thomas ---------------------------------------------------------------------------------------------------
  -->
  <ul>
    <li></li>
  </ul>
</main>

